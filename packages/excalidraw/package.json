{
  "name": "@dxos/plugin-excalidraw",
  "version": "0.8.4",
  "description": "Excalidraw sketch plugin for DXOS Composer — standalone community distribution of the @dxos/plugin-excalidraw package.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build --config vite.lib.config.ts && tsc -p tsconfig.lib.json",
    "bundle": "vite build",
    "preview": "vite preview"
  },
  "imports": {
    "#capabilities": {
      "source": "./src/capabilities/index.ts",
      "types": "./dist/types/src/capabilities/index.d.ts",
      "default": "./dist/lib/capabilities/index.js"
    },
    "#components": {
      "source": "./src/components/index.ts",
      "types": "./dist/types/src/components/index.d.ts",
      "default": "./dist/lib/components/index.js"
    },
    "#containers": {
      "source": "./src/containers/index.ts",
      "types": "./dist/types/src/containers/index.d.ts",
      "default": "./dist/lib/containers/index.js"
    },
    "#hooks": {
      "source": "./src/hooks/index.ts",
      "types": "./dist/types/src/hooks/index.d.ts",
      "default": "./dist/lib/hooks/index.js"
    },
    "#meta": {
      "source": "./src/meta.ts",
      "types": "./dist/types/src/meta.d.ts",
      "default": "./dist/lib/meta.js"
    },
    "#operations": {
      "source": "./src/operations/index.ts",
      "types": "./dist/types/src/operations/index.d.ts",
      "default": "./dist/lib/operations/index.js"
    },
    "#plugin": {
      "source": "./src/ExcalidrawPlugin.tsx",
      "types": "./dist/types/src/ExcalidrawPlugin.d.ts",
      "default": "./dist/lib/ExcalidrawPlugin.js"
    },
    "#translations": {
      "source": "./src/translations.ts",
      "types": "./dist/types/src/translations.d.ts",
      "default": "./dist/lib/translations.js"
    },
    "#types": {
      "source": "./src/types/index.ts",
      "types": "./dist/types/src/types/index.d.ts",
      "default": "./dist/lib/types/index.js"
    }
  },
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/types/src/index.d.ts",
      "default": "./dist/lib/index.js"
    },
    "./plugin": {
      "source": "./src/plugin.ts",
      "types": "./dist/types/src/plugin.d.ts",
      "default": "./dist/lib/plugin.js"
    }
  },
  "//": "@dxos/* deps resolve from the `dxos` catalog in the workspace root's pnpm-workspace.yaml — one find-replace there bumps the whole SDK in lockstep. See RELEASING.md.",
  "dependencies": {
    "@dxos/app-framework": "catalog:dxos",
    "@dxos/app-toolkit": "catalog:dxos",
    "@dxos/compute": "catalog:dxos",
    "@dxos/echo": "catalog:dxos",
    "@dxos/echo-client": "catalog:dxos",
    "@dxos/echo-doc": "catalog:dxos",
    "@dxos/echo-react": "catalog:dxos",
    "@dxos/effect": "catalog:dxos",
    "@dxos/log": "catalog:dxos",
    "@dxos/plugin-space": "catalog:dxos",
    "@dxos/react-ui": "catalog:dxos",
    "@dxos/react-ui-form": "catalog:dxos",
    "@dxos/schema": "catalog:dxos",
    "@dxos/util": "catalog:dxos",
    "@effect-atom/atom-react": "catalog:",
    "@excalidraw/excalidraw": "catalog:",
    "effect": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@storybook/react-vite": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "storybook": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plugin-wasm": "catalog:",
    "vitest": "catalog:"
  },
  "types": "./dist/types/src/index.d.ts",
  "files": [
    "dist",
    "src"
  ],
  "publishConfig": {
    "access": "public"
  }
}

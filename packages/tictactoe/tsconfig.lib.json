{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "declarationMap": true,
    // The package root, not src — meta.ts imports ../dx.config, so src alone cannot contain every input.
    "rootDir": ".",
    "outDir": "dist/types"
  },
  "include": ["src", "dx.config.ts"],
  "exclude": ["src/**/*.test.ts", "src/**/*.test.tsx", "src/**/*.stories.tsx"]
}

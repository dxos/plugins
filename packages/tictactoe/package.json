{
  "name": "@dxos/plugin-tictactoe",
  "version": "0.10.1",
  "description": "Tic-Tac-Toe plugin for DXOS Composer.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dxos/plugins.git",
    "directory": "packages/tictactoe"
  },
  "type": "module",
  "imports": {
    "#capabilities": {
      "source": "./src/capabilities/index.ts",
      "types": "./dist/types/src/capabilities/index.d.ts",
      "default": "./dist/lib/capabilities/index.js"
    },
    "#components": {
      "source": "./src/components/index.ts",
      "types": "./dist/types/src/components/index.d.ts",
      "default": "./dist/lib/components/index.js"
    },
    "#containers": {
      "source": "./src/containers/index.ts",
      "types": "./dist/types/src/containers/index.d.ts",
      "default": "./dist/lib/containers/index.js"
    },
    "#meta": {
      "source": "./src/meta.ts",
      "types": "./dist/types/src/meta.d.ts",
      "default": "./dist/lib/meta.js"
    },
    "#operations": {
      "source": "./src/operations/index.ts",
      "types": "./dist/types/src/operations/index.d.ts",
      "default": "./dist/lib/operations/index.js"
    },
    "#plugin": {
      "source": "./src/TicTacToePlugin.tsx",
      "types": "./dist/types/src/TicTacToePlugin.d.ts",
      "default": "./dist/lib/TicTacToePlugin.js"
    },
    "#translations": {
      "source": "./src/translations.ts",
      "types": "./dist/types/src/translations.d.ts",
      "default": "./dist/lib/translations.js"
    },
    "#types": {
      "source": "./src/types/index.ts",
      "types": "./dist/types/src/types/index.d.ts",
      "default": "./dist/lib/types/index.js"
    }
  },
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/types/src/index.d.ts",
      "default": "./dist/lib/index.js"
    },
    "./assets/PLUGIN.mdl": "./PLUGIN.mdl",
    "./styles.css": "./dist/lib/plugin-tictactoe.css",
    "./plugin": {
      "source": "./src/plugin.ts",
      "types": "./dist/types/src/plugin.d.ts",
      "default": "./dist/lib/plugin.js"
    },
    "./translations": {
      "source": "./src/translations.ts",
      "types": "./dist/types/src/translations.d.ts",
      "default": "./dist/lib/translations.js"
    }
  },
  "//": "@dxos/* deps resolve from the `dxos` catalog in the workspace root's pnpm-workspace.yaml — one find-replace there bumps the whole SDK in lockstep. See RELEASING.md.",
  "dependencies": {
    "@dxos/app-framework": "catalog:dxos",
    "@dxos/app-toolkit": "catalog:dxos",
    "@dxos/compute": "catalog:dxos",
    "@dxos/echo": "catalog:dxos",
    "@dxos/echo-react": "catalog:dxos",
    "@dxos/log": "catalog:dxos",
    "@dxos/plugin-game": "catalog:dxos",
    "@dxos/react-ui": "catalog:dxos",
    "@dxos/ui-theme": "catalog:dxos",
    "@dxos/util": "catalog:dxos",
    "effect": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@dxos/plugin-client": "catalog:dxos",
    "@dxos/plugin-testing": "catalog:dxos",
    "@storybook/react-vite": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "storybook": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "types": "./dist/types/src/index.d.ts",
  "files": [
    "dist",
    "src",
    "PLUGIN.mdl"
  ],
  "publishConfig": {
    "access": "public"
  }
}

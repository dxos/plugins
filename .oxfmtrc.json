{
  "jsxSingleQuote": true,
  "printWidth": 120,
  "quoteProps": "consistent",
  "singleQuote": true,
  "trailingComma": "all",
  "sortImports": {
    "groups": ["side_effect", ["builtin", "external"], "dxos", "subpath", ["parent", "sibling", "index"], "unknown"],
    "sortSideEffects": false,
    "customGroups": [
      {
        "groupName": "dxos",
        "elementNamePattern": ["@dxos/**"]
      }
    ],
    "newlinesBetween": true,
    "order": "asc"
  },
  "sortPackageJson": false,
  "ignorePatterns": [
    "**/*.mdx",
    "**/README.md",
    "**/package.json",
    "**/tsconfig.json",
    ".moon/cache",
    "coverage",
    "dist",
    "node_modules"
  ]
}

{
  "name": "dxos-plugin-excalidraw",
  "private": true,
  "version": "0.1.27",
  "description": "Excalidraw sketch plugin for DXOS Composer — standalone community distribution of the @dxos/plugin-excalidraw package.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview"
  },
  "imports": {
    "#capabilities": {
      "source": "./src/capabilities/index.ts",
      "types": "./dist/types/src/capabilities/index.d.ts",
      "default": "./dist/lib/neutral/capabilities/index.mjs"
    },
    "#components": {
      "source": "./src/components/index.ts",
      "types": "./dist/types/src/components/index.d.ts",
      "default": "./dist/lib/neutral/components/index.mjs"
    },
    "#containers": {
      "source": "./src/containers/index.ts",
      "types": "./dist/types/src/containers/index.d.ts",
      "default": "./dist/lib/neutral/containers/index.mjs"
    },
    "#hooks": {
      "source": "./src/hooks/index.ts",
      "types": "./dist/types/src/hooks/index.d.ts",
      "default": "./dist/lib/neutral/hooks/index.mjs"
    },
    "#meta": {
      "types": "@dxos/app-framework/meta",
      "default": "./dist/lib/neutral/meta.mjs"
    },
    "#operations": {
      "source": "./src/operations/index.ts",
      "types": "./dist/types/src/operations/index.d.ts",
      "default": "./dist/lib/neutral/operations/index.mjs"
    },
    "#plugin": {
      "source": "./src/ExcalidrawPlugin.tsx",
      "types": "./dist/types/src/ExcalidrawPlugin.d.ts",
      "default": "./dist/lib/neutral/ExcalidrawPlugin.mjs"
    },
    "#translations": {
      "source": "./src/translations.ts",
      "types": "./dist/types/src/translations.d.ts",
      "default": "./dist/lib/neutral/translations.mjs"
    },
    "#types": {
      "source": "./src/types/index.ts",
      "types": "./dist/types/src/types/index.d.ts",
      "default": "./dist/lib/neutral/types/index.mjs"
    }
  },
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/types/src/index.d.ts",
      "default": "./dist/lib/neutral/index.mjs"
    },
    "./plugin": {
      "source": "./src/plugin.ts",
      "types": "./dist/types/src/plugin.d.ts",
      "default": "./dist/lib/neutral/plugin.mjs"
    }
  },
  "//": "@dxos/* deps track the `main` dist-tag on npm so the plugin runs against the same Composer host code that edge-main serves. Bump SHAs in lockstep when landing a host-side change.",
  "dependencies": {
    "@automerge/automerge": "3.2.3",
    "@dxos/app-framework": "https://pkg.pr.new/dxos/dxos/@dxos/app-framework@9586e449a7",
    "@dxos/app-toolkit": "https://pkg.pr.new/dxos/dxos/@dxos/app-toolkit@9586e449a7",
    "@dxos/async": "https://pkg.pr.new/dxos/dxos/@dxos/async@9586e449a7",
    "@dxos/client": "https://pkg.pr.new/dxos/dxos/@dxos/client@9586e449a7",
    "@dxos/client-protocol": "https://pkg.pr.new/dxos/dxos/@dxos/client-protocol@9586e449a7",
    "@dxos/compute": "https://pkg.pr.new/dxos/dxos/@dxos/compute@9586e449a7",
    "@dxos/context": "https://pkg.pr.new/dxos/dxos/@dxos/context@9586e449a7",
    "@dxos/echo": "https://pkg.pr.new/dxos/dxos/@dxos/echo@9586e449a7",
    "@dxos/echo-db": "https://pkg.pr.new/dxos/dxos/@dxos/echo-db@9586e449a7",
    "@dxos/echo-react": "https://pkg.pr.new/dxos/dxos/@dxos/echo-react@9586e449a7",
    "@dxos/effect": "https://pkg.pr.new/dxos/dxos/@dxos/effect@9586e449a7",
    "@dxos/invariant": "https://pkg.pr.new/dxos/dxos/@dxos/invariant@9586e449a7",
    "@dxos/log": "https://pkg.pr.new/dxos/dxos/@dxos/log@9586e449a7",
    "@dxos/operation": "https://pkg.pr.new/dxos/dxos/@dxos/operation@9586e449a7",
    "@dxos/plugin-space": "https://pkg.pr.new/dxos/dxos/@dxos/plugin-space@9586e449a7",
    "@dxos/react-client": "https://pkg.pr.new/dxos/dxos/@dxos/react-client@9586e449a7",
    "@dxos/react-ui": "https://pkg.pr.new/dxos/dxos/@dxos/react-ui@9586e449a7",
    "@dxos/react-ui-form": "https://pkg.pr.new/dxos/dxos/@dxos/react-ui-form@9586e449a7",
    "@dxos/react-ui-stack": "https://pkg.pr.new/dxos/dxos/@dxos/react-ui-stack@9586e449a7",
    "@dxos/ui-theme": "https://pkg.pr.new/dxos/dxos/@dxos/ui-theme@9586e449a7",
    "@dxos/util": "https://pkg.pr.new/dxos/dxos/@dxos/util@9586e449a7",
    "@effect-atom/atom": "^0.5.0",
    "@effect-atom/atom-react": "^0.5.0",
    "@excalidraw/excalidraw": "^0.18.0",
    "effect": "3.21.3",
    "lodash.defaultsdeep": "^4.6.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-resize-detector": "^12.3.0"
  },
  "devDependencies": {
    "@storybook/react-vite": "^10.4.2",
    "@types/lodash.defaultsdeep": "^4.6.9",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.0",
    "typescript": "~5.9.0",
    "vite": "^8.0.0",
    "vite-plugin-wasm": "^3.6.0"
  }
}
